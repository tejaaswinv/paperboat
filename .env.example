# Firebase Admin SDK (Firebase → Project settings → Service accounts)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Protects /admin. Use a long random password in production.
ADMIN_PASSWORD=change-this-to-a-long-random-password

# Resend
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=Paper Boat <events@yourdomain.com>
ORGANIZER_EMAIL=hello@yourdomain.com

# Used in email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local-only email bypass. Keep false in production.
EMAIL_DEV_BYPASS=true
