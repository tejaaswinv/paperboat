# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx

# Must be on a verified Resend domain for production sending.
RESEND_FROM_EMAIL=Paper Boat <events@yourdomain.com>

# Optional: sends the organizer a copy of every registration.
ORGANIZER_EMAIL=hello@yourdomain.com

# Used in email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local-only bypass. Keep false in production.
EMAIL_DEV_BYPASS=true
